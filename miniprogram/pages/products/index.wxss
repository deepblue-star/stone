@import "../../styles/alpha.wxss";
.product-list { padding: 0 28rpx; }
.product-row { padding: 24rpx 0; border-bottom: 1rpx solid #eee; gap: 24rpx; }
.product-info { flex: 1; min-width: 0; }
.product-name { margin: 16rpx 0; font-size: 31rpx; font-weight: 500; line-height: 1.5; }
.product-row image, .product-placeholder { width: 220rpx; height: 220rpx; flex-shrink: 0; border-radius: 8rpx; }
.product-placeholder { background: #f4f4f4; color: #999; display: flex; justify-content: center; align-items: center; }
.buy-link { font-size: 26rpx; margin-top: 24rpx; }
.more { margin: 24rpx 28rpx; }
