@import "../../styles/catalog.wxss";
.detail-photo {
  width: 100%;
  height: 660rpx;
  background: #eeefe8;
  position: relative;
}
.detail-photo image {
  width: 100%;
  height: 100%;
}
.detail-placeholder {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #58655e;
  font-size: 28rpx;
}
.photo-hint {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 21rpx;
  color: #405b4d;
  background: #fffffff0;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}
.product-content {
  padding: 32rpx;
}
.detail-price {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  font-size: 50rpx;
  font-weight: 600;
  color: #285c4d;
}
.detail-price > text {
  font-size: 28rpx;
  margin-right: 6rpx;
}
.detail-name {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.6;
  margin-top: 10rpx;
}
.detail-stock {
  font-size: 25rpx;
  color: #58655e;
  margin: 18rpx 0 34rpx;
}
.section-label {
  font-size: 29rpx;
  font-weight: 600;
  color: #20372f;
  margin-bottom: 18rpx;
}
.spec-section,
.quantity-row,
.description-section,
.purchase-note {
  border-top: 1rpx solid #d7dfd8;
  padding-top: 30rpx;
  margin-top: 30rpx;
}
.dimension-name {
  font-size: 25rpx;
  color: #58655e;
  margin: 22rpx 0 14rpx;
}
.spec-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.spec-chip {
  min-width: 144rpx;
  max-width: 100%;
  font-size: 25rpx;
  white-space: normal;
  padding: 18rpx 24rpx;
  margin: 0;
  border: 2rpx solid #d1dcd0;
  border-radius: 12rpx;
  background: #fff;
  color: #40594c;
}
.spec-chip.selected {
  border-color: #285c4d;
  background: #e5eee5;
  color: #285c4d;
}
.spec-chip.is-disabled {
  color: #687369;
  background: #efefe9;
  opacity: 0.75;
}
.spec-chip text {
  font-size: 22rpx;
}
.quantity-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.quantity-row .section-label {
  margin-bottom: 10rpx;
}
.quantity-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}
.quantity-controls button {
  width: 88rpx;
  height: 88rpx;
  font-size: 34rpx;
  background: #e7ede4;
  color: #285c4d;
  border-radius: 10rpx;
  margin: 0;
}
.quantity-controls > text {
  min-width: 38rpx;
  text-align: center;
  font-size: 28rpx;
}
.description-body {
  font-size: 28rpx;
  color: #58655e;
  line-height: 1.9;
  white-space: pre-wrap;
}
.default-spec {
  font-size: 26rpx;
  color: #58655e;
}
.purchase-note {
  padding-bottom: 60rpx;
}
.purchase-note > view:first-child {
  font-size: 32rpx;
  color: #285c4d;
}
.purchase-note button {
  margin-top: 26rpx;
  background: #e5ebe3;
  color: #4f6556;
  border-radius: 14rpx;
  font-size: 26rpx;
}
