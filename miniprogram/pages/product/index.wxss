@import "../../styles/catalog.wxss";
.product-footer { flex-shrink: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #eee; }
.product-actions { display: flex; flex-direction: row; gap: 12rpx; align-items: center; }
.product-actions button { width: auto; min-width: 0; margin: 0; font-size: 26rpx; padding: 0 10rpx; border-radius: 12rpx; white-space: nowrap; }
.product-actions button.is-disabled { background: #eee; color: #666; opacity: 1; }
.service-action { flex: 0 0 80rpx; flex-shrink: 0; background: #fff; color: #333; }
.cart-action { flex: 0 0 200rpx; background: #f3f3f3; color: #333; }
.buy-action { flex: 1; background: #b93434; color: white; }
.purchase-error { padding: 10rpx 0 20rpx; color: #a52b2b; font-size: 25rpx; }
.detail-photo {
  width: 100%;
  height: 660rpx;
  background: #eeefe8;
  position: relative;
}
.detail-photo image {
  width: 100%;
  height: 100%;
}
.detail-gallery {
  width: 100%;
  height: 100%;
}
.detail-placeholder {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #58655e;
  font-size: 28rpx;
}
.photo-hint {
  position: absolute;
  right: 24rpx;
  bottom: 48rpx;
  font-size: 21rpx;
  color: #405b4d;
  background: #fffffff0;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}
.product-content {
  padding: 32rpx;
}
.detail-heading {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.detail-price {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  font-size: 50rpx;
  font-weight: 600;
  color: #285c4d;
}
.detail-price > text {
  font-size: 28rpx;
  margin-right: 6rpx;
}
.detail-name {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.6;
  overflow-wrap: break-word;
}
.detail-type {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #777;
}
.detail-stock {
  font-size: 25rpx;
  color: #58655e;
  margin: 18rpx 0 34rpx;
}
.section-label {
  font-size: 29rpx;
  font-weight: 600;
  color: #20372f;
  margin-bottom: 18rpx;
}
.spec-section,
.quantity-row,
.description-section,
.purchase-note {
  border-top: 1rpx solid #d7dfd8;
  padding-top: 30rpx;
  margin-top: 30rpx;
}
.dimension-name {
  font-size: 25rpx;
  color: #58655e;
  margin: 22rpx 0 14rpx;
}
.spec-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.spec-options .spec-chip {
  width: auto;
  flex: 0 0 auto;
  min-width: 108rpx;
  max-width: 100%;
  font-size: 25rpx;
  white-space: nowrap;
  min-height: 72rpx;
  padding: 12rpx 24rpx;
  margin: 0;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  background: #fff;
  color: #333;
}
.spec-chip.selected {
  border-color: #b93434;
  background: #fff;
  color: #b93434;
}
.spec-options .spec-chip.is-disabled {
  color: #666;
  background: #eee;
  opacity: 1;
}
.spec-chip text {
  font-size: 22rpx;
}
.quantity-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.quantity-row .section-label {
  margin-bottom: 10rpx;
}
.quantity-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}
.quantity-controls button {
  width: 88rpx;
  height: 88rpx;
  font-size: 34rpx;
  background: #e7ede4;
  color: #285c4d;
  border-radius: 10rpx;
  margin: 0;
}
.quantity-controls button.is-disabled { background: #eee; color: #666; opacity: 1; }
.quantity-controls > text {
  min-width: 38rpx;
  text-align: center;
  font-size: 28rpx;
}
.description-body {
  font-size: 28rpx;
  color: #58655e;
  line-height: 1.9;
  white-space: pre-wrap;
}
.default-spec {
  font-size: 26rpx;
  color: #58655e;
}
.purchase-note {
  padding-bottom: 60rpx;
}
.purchase-note > view:first-child {
  font-size: 32rpx;
  color: #285c4d;
}
.purchase-note button {
  margin-top: 26rpx;
  background: #e5ebe3;
  color: #4f6556;
  border-radius: 14rpx;
  font-size: 26rpx;
}
