<view class="screen">
  <navigation-bar title="编辑收货地址" back="{{true}}" color="#242424" background="#ffffff"/>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view wx:if="{{error}}" class="error-box">{{error}}<button class="{{loading ? 'is-disabled' : ''}}" wx:if="{{!ranges[0].length}}" bindtap="load" disabled="{{loading}}">重新读取地区</button></view>
    <view wx:if="{{loading}}" class="empty">正在读取地址与可配送地区…</view>
    <view class="group-title">联系人</view>
    <view class="form-group"><view class="field field-row"><text class="label">姓名</text><input value="{{form.receiver_name}}" data-field="receiver_name" bindinput="input" maxlength="50" placeholder="请填写收货人姓名" disabled="{{loading || submitting}}"/></view><view class="field field-row"><text class="label">手机号码</text><input value="{{form.phone}}" data-field="phone" bindinput="input" type="number" maxlength="11" placeholder="请填写11位手机号码" disabled="{{loading || submitting}}"/></view></view>
    <view class="group-title">收货地址</view>
    <view class="form-group"><view class="field field-row"><text class="label">所在区域</text><picker mode="multiSelector" range="{{ranges}}" value="{{indices}}" bindcolumnchange="columnChange" bindchange="regionChange" bindcancel="regionCancel" disabled="{{loading || submitting || !ranges[0].length}}"><view class="row between"><text class="grow">{{regionText}}</text><text class="chevron">›</text></view></picker></view><view class="field field-row"><text class="label">详细地址</text><input value="{{form.address_line}}" data-field="address_line" bindinput="input" maxlength="200" placeholder="街道、楼栋、门牌号等" disabled="{{loading || submitting}}"/></view><view class="item-note">仅展示商家已启用的可配送省份。</view></view>
    <view class="divider"/>
    <view class="section"><checkbox-group bindchange="defaultChange"><label class="row between"><text>设为默认收货地址</text><checkbox value="default" checked="{{form.set_as_default}}" color="#b93434" disabled="{{loading || submitting}}"/></label></checkbox-group><view class="item-note">保存为默认后，其他地址的默认状态会取消。</view></view>
  </scroll-view><view class="footer"><button class="primary {{loading || submitting || !ranges[0].length ? 'is-disabled' : ''}}" bindtap="save" disabled="{{loading || submitting || !ranges[0].length}}" loading="{{submitting}}">保存地址</button></view>
</view>
