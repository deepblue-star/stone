@import "../designs/commerce.wxss";
.order-filter-scroll { width: 100%; height: 121rpx; box-sizing: border-box; flex-shrink: 0; border-bottom: 1rpx solid #eee; }
.filters { display: flex; flex-direction: row; flex-wrap: nowrap; width: 840rpx; min-width: 100%; height: 120rpx; padding: 16rpx; gap: 8rpx; box-sizing: border-box; }
.filters .filter { flex: 0 0 auto; width: auto; min-width: 128rpx; height: 88rpx; min-height: 88rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 0 16rpx; margin: 0; line-height: 1.5; box-sizing: border-box; white-space: nowrap; }
