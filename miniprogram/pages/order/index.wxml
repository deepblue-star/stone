<view class="screen">
  <navigation-bar title="订单详情" back="{{true}}" color="#242424" background="#ffffff"/>
  <scroll-view class="page-scroll" scroll-y type="list">
    <view wx:if="{{paymentNote}}" class="payment-note">{{paymentNote}}</view>
    <view wx:if="{{error}}" class="error-box">{{error}}<button class="{{loading || submitting ? 'is-disabled' : ''}}" bindtap="load" disabled="{{loading || submitting}}">刷新订单状态</button></view><view wx:if="{{loading && !order}}" class="empty">正在读取订单…</view>
    <view wx:if="{{order}}"><view class="section"><view class="status">{{statusText}}</view><view class="order-number" bindtap="copyOrder">订单号 {{order.order_no}} <text class="link">复制</text></view><view class="item-note">下单时间：{{createdText}}</view><view wx:if="{{order.paid_at}}" class="item-note">付款时间：{{paidText}}</view><view wx:if="{{order.completed_at}}" class="item-note">完成时间：{{completedText}}</view><view wx:if="{{order.status === 'PENDING_PAYMENT'}}"><view class="item-note">付款截止：{{deadlineText}}</view><view class="danger">{{remaining}}</view></view><button class="secondary {{loading || submitting ? 'is-disabled' : ''}}" bindtap="load" disabled="{{loading || submitting}}">刷新状态</button></view><view class="divider"/>
      <view class="section"><view class="address-head">收货信息</view><view>{{order.address_snapshot.receiver_name}}　{{order.address_snapshot.phone_masked}}</view><view class="address-line">{{order.address_snapshot.full_address}}</view></view><view class="divider"/>
      <view wx:if="{{order.shipping}}" class="section"><view class="address-head">发货信息</view><view class="address-line">{{order.shipping.carrier_name}}</view><view class="address-line">运单号：{{order.shipping.tracking_no}}</view><view class="item-note">发货时间：{{shippedText}}</view><button class="secondary" bindtap="copyTracking">复制运单号</button></view>
      <view class="section"><view class="item-name">成交商品</view><view wx:for="{{items}}" wx:key="index" class="list-row row"><image wx:if="{{item.imageUrl}}" class="commerce-thumb" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="commerce-thumb thumb-empty">{{item.item_type === 'DESIGN' ? '设计' : '商品'}}</view><view class="grow"><view class="item-name">{{item.name}}</view><view class="item-note">{{item.specText}}</view><view class="item-note" wx:if="{{item.version}}">成交版本 V{{item.version}}</view><view class="item-note">数量 × {{item.quantity}}</view><view class="item-note">兑换券优惠 ¥{{item.discountText}}</view></view><text class="price">¥{{item.amountText}}</text></view></view><view class="divider"/>
      <view class="section"><view class="amount-line"><text>商品金额</text><text>¥{{goodsText}}</text></view><view class="amount-line"><text>材料兑换券优惠</text><text>−¥{{discountText}}</text></view><view class="amount-line"><text>运费</text><text>¥{{shippingText}}</text></view><view class="amount-line"><text>订单金额</text><text class="price">¥{{totalText}}</text></view><view wx:if="{{order.payment_mode === 'ZERO_PAY'}}" class="muted">零元订单无需微信支付，等待商家发货。</view></view>
    </view>
  </scroll-view><view class="footer bottom-actions"><button class="secondary" bindtap="contact">联系客服</button><button wx:if="{{canPay}}" class="primary {{submitting || loading ? 'is-disabled' : ''}}" bindtap="pay" disabled="{{submitting || loading}}" loading="{{submitting}}">继续支付</button></view>
</view>
