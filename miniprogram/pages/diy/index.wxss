@import "../../styles/alpha.wxss";
.design-heading { margin: 0 28rpx 20rpx; padding: 22rpx 20rpx; background: #f5f5f5; font-size: 30rpx; }
.recent-scroll { width: 100%; height: 470rpx; flex-shrink: 0; }
.recent-row { height: 450rpx; box-sizing: border-box; align-items: stretch; padding: 0 28rpx; gap: 20rpx; }
.design-card { width: 260rpx; height: 450rpx; box-sizing: border-box; display: flex; flex-direction: column; flex-shrink: 0; background: #fafafa; border: 1rpx solid #eee; border-radius: 10rpx; overflow: hidden; }
.design-card image, .design-placeholder { width: 100%; height: 240rpx; flex-shrink: 0; }
.design-placeholder { display: flex; justify-content: center; align-items: center; color: #999; }
.design-name { height: 72rpx; box-sizing: border-box; flex-shrink: 0; padding: 16rpx; font-size: 28rpx; line-height: 40rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.date { height: 48rpx; box-sizing: border-box; flex-shrink: 0; padding: 4rpx 16rpx 12rpx; font-size: 22rpx; line-height: 32rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.design-card .secondary { width: 100%; height: 88rpx; min-height: 88rpx; box-sizing: border-box; flex-shrink: 0; padding: 0 16rpx; margin: 0; line-height: 88rpx; white-space: nowrap; border-radius: 0; }
.section .custom-entry { width: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; margin: 0; padding: 60rpx 20rpx; background: #f5f5f5; border: 1rpx solid #eee; border-radius: 12rpx; line-height: 1.8; }
.custom-title { font-size: 40rpx; font-weight: 500; margin-bottom: 16rpx; }
