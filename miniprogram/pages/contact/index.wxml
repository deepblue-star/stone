<view class="screen"><navigation-bar title="客服" back="{{true}}" background="#fff" color="#242424" /><scroll-view class="page-scroll" scroll-y type="list"><view class="section"><view wx:if="{{error}}" class="error-box">{{error}}<button class="secondary {{loading?'is-disabled':''}}" disabled="{{loading}}" bindtap="load">重新读取</button></view><view wx:if="{{customer}}"><view>客服微信：{{customer.wechat_id}}</view><button class="secondary" bindtap="copy">复制微信号</button><image wx:if="{{qr}}" class="qr" src="{{qr}}" mode="aspectFit" bindtap="preview" /><view class="muted">购买、定制和退款问题请联系客服处理。</view></view><view wx:elif="{{!error}}" class="empty">{{loading?'正在读取…':'客服信息暂未配置'}}</view></view></scroll-view></view>
