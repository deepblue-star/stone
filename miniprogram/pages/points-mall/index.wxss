@import "../../styles/alpha.wxss";
.mall-category-scroll { flex-shrink: 0; height: 122rpx; border-bottom: 1rpx solid #eee; }
.mall-categories { display: flex; flex-direction: row; flex-wrap: nowrap; min-width: 100%; height: 120rpx; box-sizing: border-box; padding: 16rpx 32rpx; gap: 16rpx; }
.mall-categories .category-button { flex: 0 0 auto; width: auto; min-width: 88rpx; height: 88rpx; min-height: 88rpx; line-height: 86rpx; box-sizing: border-box; margin-left: 0; margin-right: 0; padding: 0 24rpx; white-space: nowrap; background: #fff; color: #666; border: 1rpx solid #ddd; border-radius: 8rpx; font-size: 26rpx; }
.mall-categories .category-button.selected { color: #b93434; border-color: #b93434; }
.mall-grid { flex-wrap: wrap; align-items: stretch; padding: 0 18rpx; }
.mall-card { width: 50%; padding: 12rpx; box-sizing: border-box; line-height: 1.7; }
.mall-card image, .mall-placeholder { width: 100%; height: 260rpx; background: #fafafa; border: 1rpx solid #eee; border-radius: 8rpx; box-sizing: border-box; }
.mall-placeholder { display: flex; justify-content: center; align-items: center; color: #999; }
.mall-card button { margin-top: 16rpx; }
.next { margin-top: 20rpx; }
