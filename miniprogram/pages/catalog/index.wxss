@import "../../styles/alpha.wxss";
.categories { padding: 0 28rpx; }
.category-row { padding: 28rpx 0; border-bottom: 1rpx solid #eee; }
.category-row image, .category-placeholder { width: 150rpx; height: 150rpx; border-radius: 8rpx; flex-shrink: 0; }
.category-placeholder { background: #f4f4f4; color: #999; display: flex; justify-content: center; align-items: center; }
.category-info { flex: 1; min-width: 0; padding: 0 24rpx; }
.category-name { font-size: 31rpx; line-height: 1.6; margin-bottom: 10rpx; }
