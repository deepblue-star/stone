@import "../../styles/catalog.wxss";
.catalog-topline {
  padding: 44rpx 32rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.catalog-heading {
  flex: 1;
  min-width: 0;
}
.overline {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: #58655e;
}
.catalog-title {
  font-size: 46rpx;
  line-height: 1.5;
  margin-top: 14rpx;
  color: #20372f;
  font-weight: 600;
}
.catalog-subtitle {
  font-size: 24rpx;
  color: #58655e;
  line-height: 1.8;
  margin-top: 12rpx;
}
.materials-link {
  width: 144rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  padding: 16rpx 12rpx;
  background: #e8eee7;
  color: #285c4d;
  border-radius: 12rpx;
  margin: 0;
  flex-shrink: 0;
}
.category-scroll {
  width: 100%;
  height: 106rpx;
  border-bottom: 1rpx solid #d7dfd8;
}
.category-tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  padding: 8rpx 28rpx;
}
.category-tab {
  flex-shrink: 0;
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  margin: 0 12rpx 0 0;
  background: transparent;
  color: #58655e;
  border-bottom: 5rpx solid transparent;
  border-radius: 0;
}
.category-tab.selected {
  color: #285c4d;
  font-weight: 600;
  border-color: #285c4d;
}
.product-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 28rpx 20rpx;
}
.product-card {
  box-sizing: border-box;
  width: 50%;
  padding: 0 12rpx 32rpx;
}
.product-photo {
  width: 100%;
  height: 320rpx;
  background: #eeefe8;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.product-photo image {
  width: 100%;
  height: 100%;
}
.photo-unavailable {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #58655e;
  font-size: 24rpx;
}
.sold-out {
  position: absolute;
  left: 14rpx;
  bottom: 14rpx;
  background: #fffffff0;
  color: #58655e;
  font-size: 21rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}
.product-info {
  padding: 18rpx 2rpx;
}
.product-name {
  font-size: 28rpx;
  color: #20372f;
  line-height: 1.6;
  min-height: 46rpx;
}
.product-price {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  font-size: 34rpx;
  color: #285c4d;
  margin-top: 12rpx;
  font-weight: 600;
}
.product-price > text {
  font-size: 23rpx;
  margin-right: 4rpx;
}
.product-price .price-suffix {
  margin-left: 8rpx;
  color: #58655e;
  font-size: 21rpx;
  font-weight: 400;
}
.catalog-bottom {
  text-align: center;
  padding: 30rpx 30rpx 48rpx;
  color: #58655e;
  font-size: 22rpx;
}
.catalog-bottom button {
  background: transparent;
  color: #58655e;
  font-size: 22rpx;
  min-height: 88rpx;
}
