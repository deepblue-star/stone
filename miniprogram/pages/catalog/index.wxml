<view class="screen">
  <navigation-bar title="好物" back="{{false}}" background="#fff" color="#242424" />
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="search-row row"><input value="{{keyword}}" placeholder="搜索商品" maxlength="160" confirm-type="search" bindinput="input" bindconfirm="search" /><button bindtap="search">搜索</button></view>
    <view wx:if="{{error}}" class="error-box">{{error}}<button class="secondary {{loading?'is-disabled':''}}" disabled="{{loading}}" bindtap="load">重新读取</button></view>
    <view wx:if="{{loading&&!categories.length}}" class="empty">正在读取分类…</view>
    <view wx:elif="{{!categories.length&&!error}}" class="empty">暂无商品分类</view>
    <view class="categories"><view wx:for="{{categories}}" wx:key="id" class="category-row row" data-index="{{index}}" bindtap="openCategory" aria-role="button" aria-label="{{item.name}}">
      <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load /><view wx:else class="category-placeholder">分类</view>
      <view class="category-info"><view class="category-name">{{item.name}}</view><view wx:if="{{item.item_count!==undefined}}" class="muted">{{item.item_count}} 个商品</view></view><text class="chevron">›</text>
    </view></view>
  </scroll-view>
</view>
