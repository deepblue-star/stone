page{height:100%;background:#f7f6f2;color:#20372f;font-family:'Microsoft YaHei','PingFang SC',sans-serif}.catalog-screen{display:flex;flex-direction:column;height:100%}.catalog-scroll{flex:1;min-height:0;width:100%}button{font-size:28rpx;min-height:88rpx;line-height:1.5;display:flex;align-items:center;justify-content:center;box-sizing:border-box}button::after{border:0}button[disabled]{opacity:.5}.catalog-message{margin:24rpx 32rpx;padding:24rpx;border-radius:12rpx;background:#fff3e9;line-height:1.8;font-size:26rpx}.catalog-message.error{color:#893b2b}.catalog-message button{background:transparent;color:#285c4d}.catalog-empty{padding:80rpx 38rpx;display:flex;flex-direction:column;align-items:center;text-align:center;color:#58655e;font-size:26rpx;line-height:1.9;gap:18rpx}.empty-mark{font-size:28rpx;letter-spacing:6rpx;color:#587c66}.empty-title{font-size:34rpx;font-weight:500;color:#20372f}.catalog-empty button{background:#e8eee7;color:#285c4d;padding:20rpx 30rpx;border-radius:12rpx;margin-top:16rpx}.catalog-more{background:#e8eee7;color:#285c4d;margin:12rpx 32rpx 30rpx;padding:20rpx;border-radius:12rpx}.catalog-caption{color:#58655e;font-size:24rpx;line-height:1.8}
