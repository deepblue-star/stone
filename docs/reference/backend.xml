ress()</p></td></tr><tr><td vertical-align="top"><p id="doxcnSJtEoV7uSsn6oQz2ef6b3b">地址</p></td><td vertical-align="top"><p id="doxcn1DnrY7eaNholb8HIKTq9Sf">deleteAddress</p></td><td vertical-align="top"><p id="doxcnoSegGhxGvpX3SeXBWbEXhb">DeleteAddressHandler</p></td><td vertical-align="top"><p id="doxcnn7H8X86TERvVF6a4acfmDd">AddressService.deleteAddress()</p></td></tr><tr><td vertical-align="top"><p id="doxcnLdLu8f7VlyIm5AdOTaVt4b">结算</p></td><td vertical-align="top"><p id="doxcn7JrngUX9LYiprmlr9ZOHfg">previewOrderFromCart</p></td><td vertical-align="top"><p id="doxcnajjftbd5dppb4ivEb9zSTc">PreviewOrderFromCartHandler</p></td><td vertical-align="top"><p id="doxcnTe4S9chgS7A1sErBdIegvc">CheckoutService.previewOrderFromCart()</p></td></tr><tr><td vertical-align="top"><p id="doxcnWIe9KrSvbRuMplZXbhiFMA">结算</p></td><td vertical-align="top"><p id="doxcnyOcP7GWcsnHr2KQpoft2dg">previewDirectOrder</p></td><td vertical-align="top"><p id="doxcn2klUwnN2MmZmnwsR9hjDjc">PreviewDirectOrderHandler</p></td><td vertical-align="top"><p id="doxcnDQsEQepxs2fQGOPqp3hcEf">CheckoutService.previewDirectOrder()</p></td></tr><tr><td vertical-align="top"><p id="doxcnXIHO4pqVaqTi6tOflyKl6f">结算</p></td><td vertical-align="top"><p id="doxcndARYblKZuq5wvuyk0aqMRh">createOrderFromCart</p></td><td vertical-align="top"><p id="doxcn2GaWHG9V5AmfYpQ1hULqGh">CreateOrderFromCartHandler</p></td><td vertical-align="top"><p id="doxcncsDlM82Aqwt5CnKhS03mEf">CheckoutService.createOrderFromCart()</p></td></tr><tr><td vertical-align="top"><p id="doxcnBEqYLynElJuGOypPu5b5xf">结算</p></td><td vertical-align="top"><p id="doxcnS75JpTCyxoNgvyOU0N8Lzh">createDirectOrder</p></td><td vertical-align="top"><p id="doxcnog3q0HoJULUe49hUGGHrnb">CreateDirectOrderHandler</p></td><td vertical-align="top"><p id="doxcncRSiWxl7ZvNBI5uoqa8ibc">CheckoutService.createDirectOrder()</p></td></tr><tr><td vertical-align="top"><p id="doxcnCBygeWNSlOkvm079nPYCff">订单</p></td><td vertical-align="top"><p id="doxcn4jI3NZYwb84frB7VPG8PBe">lis