oxcnA439DrHoWlpZbb7ehPLMxc">findEnabledByAuthUid</p></td></tr><tr><td vertical-align="top"><p id="doxcn7CcV6RYSYnlU8cuaLgs0g2">SiteConfigDAO</p></td><td vertical-align="top"><p id="doxcnMmdYET5AoYWbJC5Wxge3th">site_config</p></td><td vertical-align="top"><p id="doxcnujpuZmFVYt74RpqIIzaY1f">findByKey、upsert</p></td></tr></tbody></table><table id="doxcn3SwMQ25ZbMePow4Ul1E70f"><colgroup><col/><col/><col/></colgroup><thead><tr><th vertical-align="top"><p id="doxcns3Q9HPUIgBt8TKywkVD80f">DAO</p></th><th vertical-align="top"><p id="doxcnZ928kxVlV6WAcDrRNIvzbh">主表</p></th><th vertical-align="top"><p id="doxcnA1RCQjiQnl0n0hbTLfLwWd">代表性方法</p></th></tr></thead><tbody><tr><td vertical-align="top"><p id="doxcnsosu0kdHffzspnWpuKKSZc">PaymentReconciliationRunDAO</p></td><td vertical-align="top"><p id="doxcn8tflMKOs5HcrezCUUMWeof">payment_reconciliation_runs</p></td><td vertical-align="top"><p id="doxcnn1aA9eHLuyJ55qApMGp4km">findByBillDateForUpdate、insert、updateResult</p></td></tr><tr><td vertical-align="top"><p id="doxcnbJP0N0eUFj4SJSg6B6mYRh">PaymentReconciliationIssueDAO</p></td><td vertical-align="top"><p id="doxcnLb5gMmruK4k44w28gLA1xf">payment_reconciliation_issues</p></td><td vertical-align="top"><p id="doxcn1LSksKe1mAI8Umho8GEg8g">upsertIssue、listOpen、findById、resolve</p></td></tr></tbody></table><h2 id="doxcnKJDcPYlsLCA86SsNf44mec" seq="auto" seq-marker="4.5">支付 HTTP 入口与定时任务</h2><table id="doxcnzuEfVV6ktq9RHAvHYzgwKc"><colgroup><col/><col/><col/></colgroup><thead><tr><th vertical-align="top"><p id="doxcn4cO4tnRLe4wFXUK6SCQ8Hd">入口</p></th><th vertical-align="top"><p id="doxcnZdQCGTAmyn5xE31F0o5n1c">Controller / Handler</p></th><th vertical-align="top"><p id="doxcnEgwR4Q1GM3O9VTbK7PsK6d">Service 方法</p></th></tr></thead><tbody><tr><td vertical-align="top"><p id="doxcnF7cEgJbj8YuNV23SqvKeue">POST /wx-pay/wxpay_order</p></td><td vertical-align="top"><p id="doxcnLUlzHb22WqxdJvZUWLC4Sg">WxPayOrderController</p></td><td vertical-align="top"><p id="doxcnjGgjq7EHDPAAYHfnjPRFUh">PaymentService.createWechatPayment()</p></td></tr><tr><td vertical-align="top"><p id="doxcnzY3dWgHzCGVAhx8GfLrHTd">POST /wx-pay/wxpay_query_order_by_out_trade_no</p></td><td vertical-align="top"><p id="doxcnraiZvsTc0W685XPFwBZ4cd">PaymentQueryController</p></td><td vertical-align="top"><p id="doxcnAC0M9sk55SBvOECLYCN8nh">PaymentService.queryAndSync()</p></td></tr><tr><td vertical-align="top"><p id="doxcn3iUPMC5gLUo7Aq64olnvoh">微信支付通知入口</p></td><td vertical-align="top"><p id="doxcnbnipA1EuYqngXwEXUiAbPM">PaymentCallbackController</p></td><td vertical-align="top"><p id="doxcn8yEoOhgAKAK6Os8ZEWUEQe">PaymentService.handleNotification()</p></td></tr><tr><td vertical-align="top"><p id="doxcnWkWG7Dw2cxVYRDF3n1vfvb">payment-maintenance；每分钟</p></td><td vertical-align="top"><p id="doxcn67PtjSc2yySSjIgbT3YYse">PaymentMaintenanceHandler</p></td><td vertical-align="top"><p id="doxcnTmvu6hFqfJpHUSELm2nhHh">PaymentService.reconcilePendingOrders()</p></td></tr><tr><td vertical-align="top"><p id="doxcnnyf0IbviHTFr8nqKxKe8Cd">payment-bill-reconcile；每天北京时间 13:00</p></td><td vertical-align="top"><p id="doxcn449c559vLmI0ujZheDjnK7">PaymentBillReconcileHandler</p></td><td vertical-align="top"><p id="doxcnGicdEtiwRsa3GoPuPcCjPb">PaymentReconciliationService.reconcilePreviousDay()</p></td></tr></tbody></table><p id="doxcnlTjGhQlvVOnLSlnytndHZf" text-indent="1">支付 HTTP 路径和通知入口以 CloudBase 集成中心实际生成的函数为准；Controller 名称和 Service 方法是本项目代码约定。payment-maintenance 处理待付款查单与到期关单，payment-bill-reconcile 处理前一日交易账单，两者职责不得混用。</p><h2 id="doxcnsvKFpMnryapkuNCunAwj1e" seq="auto" seq-marker="4.6">积分账户创建约定</h2><p id="doxcnxmQJzJpHi01Z0wTKfw5IUe" text-indent="1">getProfileSummary、getPointsCenter 和 getMyInviteInfo 读取不到 points_accounts 时，由相应顶层 Service 在 UnitOfWork 中调用 PointsService.ensureAccount() 创建账户并立即返回。账户创建时同时生成非空唯一 invite_code，相关响应中的 invite_code 始终为字符串。</p><ol><li id="doxcnHGCEjo3kflTFAreCfvYNFe" seq="1" seq-marker="1. ">先按可信 OpenID 查询账户；存在则直接返回。</li><li id="doxcn0stei19yeD8Doq40lLSWPW" seq-marker="2. ">不存在时从大写字母 A-Z 与数字 0-9 中随机生成4位候选邀请码；先查询 invite_code 是否已经存在，已存在则重新生成，未存在才尝试插入 points_accounts。</li><li id="doxcntjALibnzWPpq8g5p84brtf" seq-marker="3. ">同一用户并发创建时，uk_points_account_openid 只允许一个请求成功；其他请求捕获该唯一键冲突后读取已创建账户。</li><li id="doxcnce1foqcP8DVAtjgLUMNWFf" seq-marker="4. ">即使前置查询未命中，仍以 uk_points_invite_code 作为并发场景下的最终唯一保证；插入命中邀请码唯一键冲突时重新生成4位候选码并重试，最多10次，仍冲突则返回系统错误；不得把空邀请码写入数据库。</li></ol><p id="doxcnSWxbv3VIzReFqNhJhiST6e">实现依据：<a href="https://docs.cloudbase.net/cloud-function/how-use">CloudBase 云函数调用与身份上下文</a>；<a href="https://docs.cloudbase.net/cloud-function/resource-integration/mysql">CloudBase MySQL 连接池与事务</a>；<a href="https://github.com/TencentCloudBase/awesome-cloudbase-examples/tree/c961f2374a1489ef6e101864b3606baa2ea55676/integration/cloudbase-wx-pay/functions/pay-common">CloudBase 微信支付示例的 routes、controllers 与 services 目录</a>。</p><h2 id="doxcnHe1JHlVG0CAXusm9tDHTth" seq="auto" seq-marker="4.7">统一接口协议</h2><p id="doxcntXTZxqf28B2WjRL5rbYLUg" text-indent="1">本节只规定所有接口共用的响应、分页和客户端提交状态。第五章各业务接口只描述本领域 data 字段和业务错误，不重复公共结构。</p><h3 id="doxcn3IxMAQ2isVE7bkwA8xVPTe" seq="auto" seq-marker="4.7.1">business-api 响应</h3><p id="doxcnaB5x7gLAAO28b628mSw63b" text-indent="1">business-api 是通过 wx.cloud.callFunction 调用的事件云函数，项目不为每个 action 自造 HTTP 状态码。云函数正常执行时统一在 result 中返回以下结构；平台级调用失败由客户端 catch 分支处理。</p><pre id="doxcnvM06Q1mELdDMhUXpIXGoRg" caption="成功响应&#xA;" lang="json" wrap="false"><code>{<br/>  "ok": true,<br/>  "code": "OK",<br/>  "message": "",<br/>  "data": {},<br/>  "request_id": "cloudbase-request-id"<br/>}</code></pre><pre id="doxcn9owwxszIY4ifbj41Wcq7FW" caption="失败响应&#xA;" lang="json" wrap="false"><code>{<br/>  "ok": false,<br/>  "code": "INVALID_ARGUMENT",<br/>  "message": "page_size必须在1到100之间",<br/>  "data": null,<br/>  "request_id": "cloudbase-request-id"<br/>}</code></pre><table id="doxcnD6rxRxHPG4phHMmwpVXdZe"><colgroup><col/><col/></colgroup><thead><tr><th vertical-align="top"><p id="doxcn54euIORhlU2EKNHl4imvse">公共 code</p></th><th vertical-align="top"><p id="doxcnnKgJBGjnzAcIXjclw4qeee">含义</p></th></tr></thead><tbody><tr><td vertical-align="top"><p id="doxcn4alUOboSklap2cAXiJqQzh">INVALID_ARGUMENT</p></td><td vertical-align="top"><p id="doxcnFlVaAXOaQ11pwQPFmCtmBc">请求字段、类型、长度、枚举或分页参数错误。</p></td></tr><tr><td vertical-align="top"><p id="doxcnaBEe0JKo8yuzj4xRR4exFf">UNAUTHORIZED</p></td><td vertical-align="top"><p id="doxcnNpgZZh0jakRmkJZGQinNpc">没有平台提供的可信用户身份或有效管理端会话。</p></td></tr><tr><td vertical-align="top"><p id="doxcnlq4cVJus2dZ5Q439ASjANf">FORBIDDEN</p></td><td vertical-align="top"><p id="doxcndmquhAQFSCvY6B1yAYla7b">当前身份不能访问该用户数据或管理能力。</p></td></tr><tr><td vertical-align="top"><p id="doxcnZCcA9tJ0t7e9QBw8Q0Wc5g">NOT_FOUND</p></td><td vertical-align="top"><p id="doxcnJBrMiNYSQOdI8d7L0UZ7ML">目标不存在、已删除或对当前身份不可见。</p></td></tr><tr><td vertical-align="top"><p id="doxcnqmrL2vRDjym1JkLHGNFdqd">CONFLICT</p></td><td vertical-align="top"><p id="doxcnGxSW5fMklXtNy50ubRDIcg">当前数据状态与请求冲突；具体业务场景使用第五章定义的领域 code。</p></td></tr><tr><td vertical-align="top"><p id="doxcnQ6h8ZSth7Lp38mdV0TTzTc">INTERNAL_ERROR</p></td><td vertical-align="top"><p id="doxcnfHWARidE5EPgIVmb5n2YDQ">本地服务异常；message不暴露SQL、凭据或堆栈。</p></td></tr></tbody></table><h3 id="doxcnrdbg1DqXyn2U6c0i2zwpGc" seq="auto" seq-marker="4.7.2">支付 HTTP 响应</h3><p id="doxcn3iXEVOYq4mvnIMg396lxsb" text-indent="1">用户小程序调用的支付 HTTP 云函数使用 HTTP 状态码表达请求处理结果，并继续使用相同 JSON 响应体。微信支付结果未知不是本地失败，返回202和PAYMENT_CONFIRMING，由用户小程序进入查单流程。微信支付通知入口的应答按5.7的通知流程执行。</p><table id="doxcnIvspiwuKY78C6Z0p6eYDpf"><colgroup><col/><col/><col/></colgroup><thead><tr><th vertical-align="top"><p id="doxcn5d6ymQq5V8oG4DUpsYj0Ob">HTTP</p></th><th vertical-align="top"><p id="doxcn7V84leRE0Tp6HZBjU6sTWd">项目 code</p></th><th vertical-align="top"><p id="doxcnc2AZkDds1NBRAd9D3C8bBe">使用场景</p></th></tr></thead><tbody><tr><td vertical-align="top"><p id="doxcnej8c7UICeITtomdOzgZsvQ">200</p></td><td vertical-align="top"><p id="doxcn90DiKRlNAVstxXZinRcRzg">OK</p></td><td vertical-align="top"><p id="doxcnBEhv1yXVmiOy344JeDdvdb">取得支付参数或查单得到明确状态。</p></td></tr><tr><td vertical-align="top"><p id="doxcnvukXi7macjJqI9Dqp67hxd">202</p></td><td vertical-align="top"><p id="doxcnR5djfuytPsc01Sy2NeNtEg">PAYMENT_CONFIRMING</p></td><td vertical-align="top"><p id="doxcn8UFzGQuUKXyBaXlBjgcNxf">微信下单或查单结果暂时无法确定；不创建新订单、不释放库存。</p></td></tr><tr><td vertical-align="top"><p id="doxcn3W7pNbTd4z1ynHG6v0OFLg">400</p></td><td vertical-align="top"><p id="doxcnXPqadVkab2EaiUsAB3SnDc">INVALID_ARGUMENT</p></td><td vertical-align="top"><p id="doxcnmRIobnixG5kxANWEa2tscg">请求体或order_no格式错误。</p></td></tr><tr><td vertical-align="top"><p id="doxcnTBXDGZtfEIoa029amwBSve">401</p></td><td vertical-align="top"><p id="doxcnhxzquXpGSY0q9nHAKpvaie">UNAUTHORIZED</p></td><td vertical-align="top"><p id="doxcnJlM5Xa6yxfx4IxIkB4voTg">缺少可信小程序用户身份。</p></td></tr><tr><td vertical-align="top"><p id="doxcnUcYWv8yOTVN5VyB5YmFYAc">403</p></td><td vertical-align="top"><p id="doxcnNjhJdM2ZtBe1ryTP5JY4je">FORBIDDEN</p></td><td vertical-align="top"><p id="doxcnTlTVLDg1LRS9tHcG3kVIMc">订单不属于当前用户。</p></td></tr><tr><td vertical-align="top"><p id="doxcn5tXwmdiaA9LNwJKhUu4eng">404</p></td><td vertical-align="top"><p id="doxcnnyuzqMzdsRQ4XpZbbXazKb">ORDER_NOT_FOUND</p></td><td vertical-align="top"><p id="doxcnGc76wpxREk9Oyo5UQjnqRg">本地业务订单不存在。</p></td></tr><tr><td vertical-align="top"><p id="doxcn9TWALnXMbrLcIkUIa9btuf">409</p></td><td vertical-align="top"><p id="doxcnv8CZAotUbTAWYSUtK5qkZd">PAYMENT_EXPIRED / INVALID_ORDER_STATE</p></td><td vertical-align="top"><p id="doxcnaIfjRfstYWNzYkcTyCh5Yc">超过支付截止时间、订单已关闭或状态不允许继续支付。</p></td></tr><tr><td vertical-align="top"><p id="doxcnVJ7uRyMPEoLA0b7cJvtU3u">500</p></td><td vertical-align="top"><p id="doxcny8K70iAnPh5lx0eF0xFaCh">INTERNAL_ERROR</p></td><td vertical-align="top"><p id="doxcn69wgxzbfDOYqDxqjjUtamc">本地服务异常。</p></td></tr><tr><td vertical-align="top"><p id="doxcnetBnTPyQs5dcHqCLZZ0Njd">502</p></td><td vertical-align="top"><p id="doxcnzEMAXGzuMBy7HLXDsUhVFc">WECHAT_PAY_REJECTED</p></td><td vertical-align="top"><p id="doxcnZ5TYPB7UjXAf8MapnUImuc">微信支付明确拒绝请求且结果不是未知状态。</p></td></tr></tbody></table><pre id="doxcnAK54p4jA04dhyj8wlZx5Pe" caption="支付结果确认中&#xA;" lang="json" wrap="false"><code>{<br/>  "ok": false,<br/>  "code": "PAYMENT_CONFIRMING",<br/>  "message": "正在确认支付结果",<br/>  "data": {"order_no": "O202610070001"},<br/>  "request_id": "cloudbase-request-id"<br/>}</code></pre><h3 id="doxcnB2WNNojwOM9MYQ9wUrAQwF" seq="auto" seq-marker="4.7.3">分页约定</h3><pre id="doxcnjHy9RIxOJz1ANg28VfpJXf" caption="分页请求&#xA;" lang="json" wrap="false"><code>{<br/>  "page_token": null,<br/>  "page_size": 20<br/>}</code></pre><pre id="doxcnqpxCLEaKo0ZOVTsevagTbf" caption="分页响应&#xA;" lang="json" wrap="false"><code>{<br/>  "items": [],<br/>  "next_page_token": null<br/>}</code></pre><p id="doxcni80KMWPs2r6f9fHRWM66xh" text-indent="1">page_size默认20，最大100；next_page_token为空表示没有下一页。各业务接口可以把items改成语义更明确的orders、coupons等数组名，但分页字段含义保持一致。</p><h3 id="doxcnBP87Xz6AKClfiJzBtKTKGc" seq="auto" seq-marker="4.7.4">客户端写操作状态</h3><p id="doxcnA60nHQs0F5zfWHGPlJqfrg" text-indent="1">用户小程序和商家Web管理端的所有写按钮统一维护submitting状态：第一次点击后立即禁用并显示处理中；请求成功后跳转或刷新数据；明确失败后恢复；不能使用固定延时自动恢复。该规则覆盖保存设计、购物车修改、地址保存、目录保存、提交订单、支付、签到、积分兑换、库存调整、发货、完成订单以及SKU下架或删除。前端防重复用于改善交互，后端唯一约束、幂等键和事务继续承担最终一致性。</p></fragment>
